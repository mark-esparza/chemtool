# No AI/model API key is required — all chemistry (reaction prediction,
# balancing, molecular properties, design pipeline, and reports) runs
# deterministically on-device. PubChem lookups use the public NCBI REST API
# with an offline library fallback.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
