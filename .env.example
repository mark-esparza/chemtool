# No AI/model API key is required — all chemistry (reaction prediction,
# balancing, molecular properties, design pipeline, and reports) runs
# deterministically on-device. Compound lookups are routed live to the NIH
# PubChem REST API on every search, so the server needs outbound network access
# to pubchem.ncbi.nlm.nih.gov.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
